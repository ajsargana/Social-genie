{
  "name": "@social-genie/database",
  "version": "1.0.0",
  "description": "Database schema and migrations for Social Genie",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "knex seed:run",
    "db:reset": "knex migrate:rollback:all && knex migrate:latest && knex seed:run"
  },
  "dependencies": {
    "@social-genie/shared-types": "workspace:*",
    "knex": "^3.0.1",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/pg": "^8.10.9",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "migrations"
  ]
}