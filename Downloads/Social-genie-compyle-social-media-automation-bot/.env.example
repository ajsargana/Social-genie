# =============================================================================
# Social Genie - Environment Configuration
# =============================================================================

# Application Configuration
NODE_ENV=development
PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-in-production

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/socialgenie_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=socialgenie_dev
DB_USER=postgres
DB_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Security Configuration
JWT_SECRET=your-jwt-secret-change-in-production-min-32-chars
ENCRYPTION_KEY=your-encryption-key-32-characters-long!!

# AI Service Configuration
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Social Media API Keys
AYRSHARE_API_KEY=your-ayrshare-api-key
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
TIKTOK_CLIENT_ID=your-tiktok-client-id
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
YOUTUBE_API_KEY=your-youtube-api-key
PINTEREST_APP_ID=your-pinterest-app-id
PINTEREST_APP_SECRET=your-pinterest-app-secret

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-for-verification

# External Services
SENTRY_DSN=your-sentry-dsn-for-error-tracking
ANALYTICS_API_KEY=your-analytics-api-key

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@socialgenie.com

# File Storage Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=social-genie-media

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Background Job Configuration
JOB_CONCURRENCY_CONTENT_GENERATION=5
JOB_CONCURRENCY_SOCIAL_POSTING=10
JOB_CONCURRENCY_ANALYTICS=20
JOB_CONCURRENCY_ENGAGEMENT=15

# Content Generation Configuration
DEFAULT_CONTENT_TONE=friendly
DEFAULT_CONTENT_LENGTH=medium
DEFAULT_MEDIA_TYPE=image
MAX_HASHTAGS_PER_POST=30
MAX_POST_LENGTH_TWITTER=280
MAX_POST_LENGTH_INSTAGRAM=2200

# Analytics Configuration
ANALYTICS_RETENTION_DAYS=180
PERFORMANCE_TRACKING_ENABLED=true

# Development Configuration
DEBUG=social-genie:*
LOG_LEVEL=debug
ENABLE_SWAGGER=true
ENABLE_CORS=true

# Testing Configuration
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/socialgenie_test
MOCK_SOCIAL_APIS=false
MOCK_AI_APIS=false

# Production Configuration
CORS_ORIGIN=https://yourdomain.com
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
SESSION_SECRET=your-session-secret-change-in-production

# Monitoring Configuration
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# Feature Flags
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_AUTO_REPLY=true
ENABLE_CONTENT_OPTIMIZATION=true
ENABLE_PERFORMANCE_ANALYSIS=true
ENABLE_REAL_TIME_MONITORING=true

# Social Media Platform Settings
DAILY_POST_LIMIT_TWITTER=10
DAILY_POST_LIMIT_INSTAGRAM=5
DAILY_POST_LIMIT_FACEBOOK=5
DAILY_POST_LIMIT_LINKEDIN=3
DAILY_POST_LIMIT_TIKTOK=3
DAILY_POST_LIMIT_YOUTUBE=2
DAILY_POST_LIMIT_PINTEREST=10

# Content Categories
ENABLE_DAILY_MOVIE=true
ENABLE_PRODUCT_SHOWCASE=true
ENABLE_DAILY_QUOTE=true
ENABLE_NEWS_CONTENT=true
ENABLE_EDUCATIONAL_CONTENT=true
ENABLE_ENTERTAINMENT_CONTENT=true
ENABLE_PROMOTIONAL_CONTENT=true

# AI Model Configuration
DEFAULT_AI_PROVIDER=openai
OPENAI_MODEL=gpt-5
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000
AI_CREATIVITY_LEVEL=7

# Backup Configuration
ENABLE_AUTO_BACKUP=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=social-genie-backups

# Notification Settings
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_WEBHOOK_ENABLED=true
NOTIFICATION_SLACK_WEBHOOK=your-slack-webhook-url

# Integration Settings
ENABLE_AYRSHARE_INTEGRATION=true
ENABLE_DIRECT_PLATFORM_INTEGRATION=false
PRIMARY_SOCIAL_PROVIDER=ayrshare

# Performance Settings
CACHE_TTL_SECONDS=3600
MAX_CACHE_SIZE_MB=100
ENABLE_QUERY_CACHE=true
ENABLE_RESPONSE_CACHE=true

# Security Settings
ENABLE_RATE_LIMITING=true
ENABLE_CORS_PROTECTION=true
ENABLE_INPUT_VALIDATION=true
ENABLE_SQL_INJECTION_PROTECTION=true
ENABLE_XSS_PROTECTION=true

# API Configuration
API_VERSION=v1
API_PREFIX=/api
API_DOCS_ENABLED=true
API_EXPERIMENTAL_FEATURES=false